# Runtime mode
CARD_READER_ENV=development

# API bind target on the host machine (for Docker Compose port publishing)
CARD_READER_API_BIND=127.0.0.1

# Database location relative to the fixed container storage root
CARD_READER_DATABASE_PATH=card_reader.db

# The parser image uses linux/amd64 because the locked PaddlePaddle release does not publish a
# Linux ARM64 wheel. Docker Desktop handles the required emulation on Apple Silicon.
CARD_READER_PARSER_PLATFORM=linux/amd64

# The default Compose deployment bind-mounts these host paths. Keep production values outside
# committed env files. The local Compose override uses a Docker-managed volume instead.
# CARD_READER_APP_DATA_DIR=/var/lib/card-reader
# CARD_READER_PUBLIC_APP_DATA_DIR=/var/lib/card-reader/public

# Production publishing/serving configuration. Leave unset for local bootstrap.
# CARD_READER_DEVELOPER_DATA_DIR=/var/lib/card-reader/dev-data
# CARD_READER_DEVELOPER_DATA_ACCEL_REDIRECT_PREFIX=/_internal/card-reader-dev-data/
# CARD_READER_DEVELOPER_DATA_PUBLIC_API_BASE_URL=https://maityscardgame.com/api
# CARD_READER_RELEASE_REVISION=unknown

# Disable crop dumps in production by default
CARD_READER_SAVE_DEBUG_CROPS=false

# Set your frontend origin(s) as JSON array
# Example: ["https://cards.example.com","https://admin.example.com"]
CARD_READER_CORS_ORIGINS=["http://127.0.0.1:5173", "http://localhost:5173", "http://127.0.0.1:8888", "http://localhost:8888"]

# Django development settings
CARD_READER_DJANGO_SECRET_KEY=secretkey
CARD_READER_ALLOWED_HOSTS=["127.0.0.1", "localhost"]
CARD_READER_CSRF_TRUSTED_ORIGINS=["http://127.0.0.1:5173", "http://localhost:5173", "http://127.0.0.1:8888", "http://localhost:8888"]

# Skip Paddle model host connectivity check
PADDLE_PDX_DISABLE_MODEL_SOURCE_CHECK=True

# Keep Paddle OCR on conservative CPU settings to avoid native runtime instability.
OMP_NUM_THREADS=1
MKL_NUM_THREADS=1
OPENBLAS_NUM_THREADS=1
FLAGS_use_mkldnn=0
