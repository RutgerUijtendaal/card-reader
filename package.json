{
  "name": "card-reader",
  "private": true,
  "packageManager": "pnpm@10.0.0",
  "scripts": {
    "preflight": "node scripts/check-prerequisites.mjs",
    "deps:js": "pnpm install",
    "deps:py": "node scripts/check-native-platform.mjs && uv sync --project . --all-packages --all-groups --locked",
    "setup:deps": "pnpm deps:js && pnpm deps:py",
    "bootstrap:dev": "pnpm run setup:deps && uv run --project . --package card-reader-api python scripts/bootstrap-dev.py",
    "bootstrap:dev:reset": "pnpm run setup:deps && uv run --project . --package card-reader-api python scripts/bootstrap-dev.py --reset",
    "sync:python": "pnpm deps:py",
    "dev": "turbo run dev dev:builder dev:tts-sheets --parallel",
    "dev:all": "turbo run dev dev:builder dev:tts-sheets --parallel",
    "build": "turbo run build",
    "test": "pnpm test:scripts && turbo run test",
    "test:scripts": "node --test scripts/*.test.mjs",
    "lint": "turbo run lint",
    "fix": "turbo run fix",
    "typecheck": "turbo run typecheck",
    "check": "turbo run typecheck && turbo run lint && turbo run test",
    "format": "turbo run format"
  },
  "devDependencies": {
    "turbo": "^2.1.1"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "unrs-resolver",
      "vue-demi"
    ]
  }
}
